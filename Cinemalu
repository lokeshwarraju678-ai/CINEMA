<!DOCTYPE html>
<html lang="te">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>CineMax - Universal Movie Stream</title>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; }
    body { background-color: #0b0c0e; color: #e1e1e1; padding-bottom: 50px; }

    /* Movierulz Style Navbar */
    header {
      background: #14161d;
      padding: 12px 15px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      border-bottom: 2px solid #00acc1;
      position: sticky; top: 0; z-index: 100;
    }
    .logo { font-size: 20px; font-weight: 900; color: #fff; letter-spacing: 0.5px; }
    .logo span { color: #00acc1; }
    .btn-admin {
      background: #00acc1; color: #000; border: none; font-weight: bold;
      padding: 6px 12px; border-radius: 4px; font-size: 12px; cursor: pointer;
    }

    .container { max-width: 850px; margin: 12px auto; padding: 0 10px; }

    /* Admin Link Add Box */
    #adminBox {
      display: none; background: #14161d; border: 1px solid #00acc1;
      border-radius: 6px; padding: 14px; margin-bottom: 15px;
    }
    #adminBox h3 { font-size: 14px; color: #00acc1; margin-bottom: 10px; }
    .input-field {
      width: 100%; padding: 10px; margin-bottom: 8px; background: #1f222e;
      border: 1px solid #32374a; border-radius: 4px; color: #fff; font-size: 13px; outline: none;
    }
    .btn-submit {
      width: 100%; padding: 10px; background: #00acc1; color: #000;
      border: none; border-radius: 4px; font-weight: bold; cursor: pointer; font-size: 14px;
    }

    /* Video Player Wrapper */
    .player-card {
      background: #000; border-radius: 8px; overflow: hidden;
      margin-bottom: 18px; border: 1px solid #202433; box-shadow: 0 4px 20px rgba(0,0,0,0.7);
    }
    .media-box {
      position: relative; width: 100%; padding-bottom: 56.25%; height: 0; background: #000;
    }
    .media-box iframe, .media-box video {
      position: absolute; top: 0; left: 0; width: 100%; height: 100%; border: none;
    }
    .movie-bar {
      padding: 10px 14px; background: #14161d; display: flex;
      justify-content: space-between; align-items: center; border-top: 1px solid #202433;
    }
    .movie-bar h2 { font-size: 15px; color: #fff; }
    .badge { background: #e50914; color: #fff; font-size: 11px; padding: 2px 6px; border-radius: 3px; font-weight: bold; }

    /* Movierulz Poster Grid */
    .section-head {
      font-size: 15px; margin: 15px 0 10px; color: #00acc1;
      font-weight: bold; text-transform: uppercase; letter-spacing: 0.5px;
    }
    .grid {
      display: grid; grid-template-columns: repeat(2, 1fr); gap: 10px;
    }
    @media (min-width: 600px) {
      .grid { grid-template-columns: repeat(4, 1fr); }
    }
    .card {
      background: #14161d; border-radius: 6px; overflow: hidden;
      cursor: pointer; border: 1px solid #202433; transition: transform 0.15s ease;
    }
    .card:hover { transform: scale(1.02); border-color: #00acc1; }
    .card-thumb { position: relative; width: 100%; height: 210px; }
    .card-thumb img { width: 100%; height: 100%; object-fit: cover; display: block; }
    .quality-tag {
      position: absolute; top: 6px; right: 6px; background: rgba(0,0,0,0.75);
      border: 1px solid #00acc1; color: #00acc1; font-size: 10px; padding: 2px 5px;
      border-radius: 3px; font-weight: bold;
    }
    .card-info { padding: 8px; }
    .card-info h4 {
      font-size: 13px; font-weight: 600; white-space: nowrap;
      overflow: hidden; text-overflow: ellipsis; color: #fff;
    }
    .card-info span { font-size: 11px; color: #8892b0; }
  </style>
</head>
<body>

  <!-- Top Movierulz Header -->
  <header>
    <div class="logo">CINEMA<span>MAX</span></div>
    <button class="btn-admin" onclick="toggleAdmin()">➕ Add Link</button>
  </header>

  <div class="container">

    <!-- Admin Link Inserter -->
    <div id="adminBox">
      <h3>🎬 Add Any Video / Stream Link</h3>
      <input type="text" id="mTitle" class="input-field" placeholder="Movie Title (e.g. Game Changer)">
      <input type="text" id="mPoster" class="input-field" placeholder="Poster Image URL (Optional)">
      <input type="text" id="mLink" class="input-field" placeholder="Paste Any Video URL / Embed Link">
      <button class="btn-submit" onclick="addCustomMovie()">Save & Play Link</button>
    </div>

    <!-- Universal Screen Player -->
    <div class="player-card">
      <div class="media-box" id="playerContainer">
        <!-- Direct Video Tag Default -->
        <video id="html5Player" controls playsinline poster="https://images.unsplash.com/photo-1536440136628-849c177e76a1?w=500">
          <source src="https://commondatastorage.googleapis.com/gtv-videos-bucket/sample/BigBuckBunny.mp4" type="video/mp4">
        </video>
      </div>
      <div class="movie-bar">
        <h2 id="nowPlayingTitle">Telugu Action Special (HD)</h2>
        <span class="badge">HD RIP</span>
      </div>
    </div>

    <!-- Movie Catalog -->
    <div class="section-head">⚡ Featured Movies</div>
    <div class="grid" id="catalog"></div>

  </div>

  <script>
    // Demo Movies
    let library = [
      {
        title: "Action Movie (Direct MP4)",
        poster: "https://images.unsplash.com/photo-1536440136628-849c177e76a1?w=500",
        url: "https://commondatastorage.googleapis.com/gtv-videos-bucket/sample/BigBuckBunny.mp4"
      },
      {
        title: "Sci-Fi Thriller (Direct MP4)",
        poster: "https://images.unsplash.com/photo-1489599849927-2ee91cede3ba?w=500",
        url: "https://commondatastorage.googleapis.com/gtv-videos-bucket/sample/ElephantsDream.mp4"
      }
    ];

    function renderCatalog() {
      const container = document.getElementById('catalog');
      container.innerHTML = "";
      library.forEach((item, index) => {
        container.innerHTML += `
          <div class="card" onclick="loadVideo(${index})">
            <div class="card-thumb">
              <img src="${item.poster}" alt="Poster">
              <div class="quality-tag">HD</div>
            </div>
            <div class="card-info">
              <h4>${item.title}</h4>
              <span>Watch Online</span>
            </div>
          </div>
        `;
      });
    }

    // Smart Universal Video Detector
    function loadVideo(index) {
      const item = library[index];
      const link = item.url.trim();
      const pContainer = document.getElementById('playerContainer');
      const titleTag = document.getElementById('nowPlayingTitle');
      titleTag.innerText = item.title;

      // 1. YouTube Link Check
      if (link.includes("youtube.com") || link.includes("youtu.be")) {
        let vid = "";
        if (link.includes("youtu.be/")) vid = link.split("youtu.be/")[1].split("?")[0];
        else if (link.includes("watch?v=")) vid = link.split("watch?v=")[1].split("&")[0];
        else if (link.includes("embed/")) vid = link.split("embed/")[1].split("?")[0];
        
        pContainer.innerHTML = `<iframe src="https://www.youtube-nocookie.com/embed/${vid}?autoplay=1&rel=0" allowfullscreen allow="autoplay; encrypted-media"></iframe>`;
      } 
      // 2. Direct MP4 / WebM / Video File
      else if (link.endsWith(".mp4") || link.endsWith(".webm") || link.includes("googlevideo") || link.includes(".mp4?")) {
        pContainer.innerHTML = `
          <video controls autoplay playsinline style="width:100%; height:100%;">
            <source src="${link}" type="video/mp4">
          </video>`;
      } 
      // 3. Any Other Web Player / Embed Link
      else {
        pContainer.innerHTML = `<iframe src="${link}" allowfullscreen allow="autoplay; encrypted-media"></iframe>`;
      }

      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    function toggleAdmin() {
      const b = document.getElementById('adminBox');
      b.style.display = b.style.display === 'block' ? 'none' : 'block';
    }

    function addCustomMovie() {
      const t = document.getElementById('mTitle').value.trim();
      const p = document.getElementById('mPoster').value.trim();
      const l = document.getElementById('mLink').value.trim();

      if (!t || !l) {
        alert("దయచేసి టైటిల్ మరియు వీడియో లింక్ ఇవ్వండి!");
        return;
      }

      const finalPoster = p || "https://images.unsplash.com/photo-1489599849927-2ee91cede3ba?w=500";

      library.unshift({
        title: t,
        poster: finalPoster,
        url: l
      });

      renderCatalog();
      loadVideo(0);
      toggleAdmin();
      alert("సినిమా లింక్ విజయవంతంగా యాడ్ అయ్యింది!");
    }

    renderCatalog();
  </script>
</body>
</html>
